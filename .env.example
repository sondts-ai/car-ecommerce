# =============================================================
# AutoWeb — biến môi trường cho lớp kết nối API
# Sao chép file này thành `.env.local` rồi chỉnh giá trị nếu cần.
# =============================================================

# Base URL của API.
# - Dùng mock backend tích hợp sẵn trong Next.js: /api
# - Khi nối backend thật: https://api.autoweb.vn/v1 (hoặc URL nội bộ)
NEXT_PUBLIC_API_BASE_URL=/api

# Timeout mỗi request (mili giây)
NEXT_PUBLIC_API_TIMEOUT=15000

# Mock API cho các luồng chưa có service backend (xe công khai, đặt cọc,
# thanh toán và lái thử).
NEXT_PUBLIC_USE_MOCK_API=true

# Kết nối các service backend đã triển khai (auth, customer, order).
# Đặt false nếu muốn chạy hoàn toàn bằng mock API.
NEXT_PUBLIC_USE_BACKEND_SERVICES=true
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_CUSTOMER_API_URL=http://localhost:8082/api/v1
NEXT_PUBLIC_ORDER_API_URL=http://localhost:8083/api/v1
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:8086/api/v1
