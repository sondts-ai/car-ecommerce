# =============================================================
# AutoWeb — biến môi trường cho deploy production (Docker Compose)
# Không commit file .env thật. Jenkins tạo .env trên server từ Credentials.
# =============================================================

# Image do CI build/push. Ví dụ: 123456789.dkr.ecr.ap-southeast-1.amazonaws.com/car-ecommerce
IMAGE_PREFIX=registry.example.com/car-ecommerce
IMAGE_TAG=latest

# Cổng public trên VM/instance (sau đó trỏ Security Group / Cloudflare tới đây)
GATEWAY_PORT=8080
FRONTEND_PORT=3000
# Chỉ mở MySQL trên loopback; không set 0.0.0.0 trên cloud.
MYSQL_BIND=127.0.0.1

# --- Database ---
MYSQL_ROOT_PASSWORD=change-me
DB_USERNAME=car_app
DB_PASSWORD=change-me

# --- JWT (>= 32 byte, giống nhau ở mọi service) ---
JWT_SECRET=change-me-at-least-32-bytes-long!!
JWT_ISSUER=car-sales-auth
ORDER_INTERNAL_KEY=change-me

# --- CORS: domain thật của frontend ---
CORS_ALLOWED_ORIGINS=https://autoweb.example.com

# --- Frontend (BUILD-TIME, phải là URL public mà trình duyệt gọi được) ---
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_TIMEOUT=15000
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_USE_BACKEND_SERVICES=true
NEXT_PUBLIC_AUTH_API_URL=https://api.autoweb.example.com/api/v1
NEXT_PUBLIC_CUSTOMER_API_URL=https://api.autoweb.example.com/api/v1
NEXT_PUBLIC_ORDER_API_URL=https://api.autoweb.example.com/api/v1
NEXT_PUBLIC_PAYMENT_API_URL=https://api.autoweb.example.com/api/v1
